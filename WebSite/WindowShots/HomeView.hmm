    HtmlMetaData = "<html><head><title>MapSpinner Page</title><meta name=\"GENERATOR\" content=\"MapSpinner\"></head><body><p></p><!-- Created by MapSpinner --><!-- Beginning --><img src=\"HomeView.png\" width=\"876\" height=\"656\" usemap=\"#HomeView\" border=\"0\"><map name=\"HomeView\"><area shape=\"rect\" coords=\"414,542,614,562\" alt=\"Path\" title=\"This area shows the number of carousels that were detected.\" nohref><area shape=\"rect\" coords=\"494,482,695,503\" alt=\"Feedback\" title=\"Click this button to send e-mail describing any problems you are having or to suggest nifty new features.\" nohref><area shape=\"rect\" coords=\"507,420,622,441\" href=\"screenshot/addslot.html\" alt=\"Add\" title=\"Use this button to add a disk to the library.\"><area shape=\"rect\" coords=\"430,228,705,249\" alt=\"Search\" title=\"Searches for disks in the library by their name, comments, or tags.\" nohref><area shape=\"rect\" coords=\"344,53,369,74\" href=\"screenshot/addslot.html\" alt=\"Add\" title=\"Use this button to add a disk to the library.\"><area shape=\"rect\" coords=\"255,53,280,74\" alt=\"Mount button\" title=\"Use this button to open the selected item after you have inserted a disk into your computer. \" nohref><area shape=\"rect\" coords=\"126,53,151,74\" alt=\"Check In\" title=\"Use this button to manually check a disk back into the library.  in normal use, you simply insert the disk into your drive and the program will automatically select the correct slot and open the door of the carousel.\" nohref><area shape=\"rect\" coords=\"631,53,828,74\" alt=\"Search\" title=\"Searches for disks in the library by their name, comments, or tags.\" nohref><area shape=\"rect\" coords=\"510,53,535,74\" alt=\"GoTo\" title=\"Click on this button to open the slot on the carousel.  Using this button will not change the time of the last check out.\" nohref><area shape=\"rect\" coords=\"384,53,409,74\" alt=\"Delete\" title=\"Use this button to delete the slot from the library.\" nohref><area shape=\"rect\" coords=\"293,53,318,74\" alt=\"Eject\" title=\"Use this button to eject a disk from your disk drive, hold option key down to eject a second drive.\" nohref><area shape=\"rect\" coords=\"455,53,480,74\" alt=\"Close Door\" title=\"Use this button to close the door of the carousel.\" nohref><area shape=\"rect\" coords=\"66,53,91,74\" alt=\"Check Out\" title=\"Use this button to check out a disk from the library. The last checkout date will be updated to the current time, and that this will be flagged as checked out.\" onmouseover=\"window.status='YOUR_MESSAGE';return true;\" nohref><area shape=\"rect\" coords=\"55,157,185,171\" alt=\"Movies\" title=\"Displays all the slots which have disks identified as movies.\" nohref><area shape=\"rect\" coords=\"55,223,185,261\" alt=\"Carousels\" title=\"Select one of your carousels to show the contents of the library for the carousel.\" nohref><area shape=\"rect\" coords=\"55,313,185,498\" alt=\"Search For\" title=\"Select one of these predefined search patterns to display slots matching the pattern.\" nohref><area shape=\"rect\" coords=\"55,268,185,287\" alt=\"Bookmarks\" title=\"Store favorite or frequently used disks here to quickly select a disk.\" nohref><area shape=\"rect\" coords=\"55,139,185,153\" alt=\"Images\" title=\"Displays all the slots which have disks identified as images or pictures.\" nohref><area shape=\"rect\" coords=\"55,179,185,193\" alt=\"Music\" title=\"Displays all slots containing disks marked as music.\" nohref><area shape=\"rect\" coords=\"55,119,185,134\" alt=\"Files\" title=\"Displays all the slots which have disks identified as files.\" nohref><area shape=\"rect\" coords=\"193,96,835,580\" alt=\"Background\" title=\"This is the background area of the home view. You may change the background by dragging in any desired picture from the finder.\" nohref></map><!-- End --></body></html>";
