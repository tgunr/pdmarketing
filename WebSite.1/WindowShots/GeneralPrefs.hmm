    HtmlMetaData = "<html><head><title>MapSpinner Page</title><meta name=\"GENERATOR\" content=\"MapSpinner\"></head><body><p></p><!-- Created by MapSpinner --><!-- Beginning --><img src=\"GeneralPrefs.png\" width=\"529\" height=\"445\" usemap=\"#GeneralPrefs\" border=\"0\"><map name=\"GeneralPrefs\"><area shape=\"rect\" coords=\"297,340,460,361\" title=\" Use this setting to display the rating assigned to the disk in the Main Library view.\" nohref><area shape=\"rect\" coords=\"297,276,460,297\" title=\" Use this setting to display the date the disk was added and the Main Library view.\" nohref><area shape=\"rect\" coords=\"297,298,460,319\" title=\" Use this setting to display if the disk has been checked out of the library in the Main Library view.\" nohref><area shape=\"rect\" coords=\"297,320,460,341\" title=\" Use this setting to display the date that this was last checked out in the Main Library view.\" nohref><area shape=\"rect\" coords=\"72,340,235,361\" title=\" Use this setting to display the tags assigned to the disk in the Main Library view.\" nohref><area shape=\"rect\" coords=\"72,320,235,341\" title=\" Use this setting to display the comments entered for the disk and the Main Library view.\" nohref><area shape=\"rect\" coords=\"72,298,235,319\" title=\" Is this setting to display the type of disk in the Main Library view.\" nohref><area shape=\"rect\" coords=\"72,276,235,297\" title=\" Is this to display the slot number in the Main Library list view.\" nohref><area shape=\"rect\" coords=\"70,223,336,243\" alt=\"AutoOpen\" title=\" Use this setting to cause the carousel to automatically open the slot after a disk has been indexed and cataloged.\" nohref><area shape=\"rect\" coords=\"69,202,335,222\" alt=\"AutoEject\" title=\" Use this setting to automatically eject a disk after it has been indexed and cataloged.\" nohref><area shape=\"rect\" coords=\"74,144,237,165\" alt=\"PaySounds\" title=\" Use this checkbox to control the play of sound effects.\" nohref><area shape=\"rect\" coords=\"303,44,355,98\" href=\"advancedprefs.html\" alt=\"AdvancedPrefs\" title=\" Select the advanced preferences panel.\"><area shape=\"rect\" coords=\"252,44,304,98\" href=\"driverprefs.html\" alt=\"DriverPrefs\" title=\" Select the driver preferences panel.\"><area shape=\"rect\" coords=\"201,44,253,98\" href=\"updateprefs.html\" alt=\"UpdatePrefs\" title=\" Select the update preferences panel.\"><area shape=\"rect\" coords=\"150,44,202,98\" href=\"sidebarprefs.html\" alt=\"SidebarPrefs\" title=\" Select the sidebar preferences panel.\"><area shape=\"rect\" coords=\"99,44,151,98\" href=\"discoveryprefs.html\" alt=\"DiscoveryPrefs\" title=\"Select the discovery preferences panel.\"><area shape=\"rect\" coords=\"48,44,100,98\" href=\"generalprefs.html\" alt=\"GeneralPrefs\" title=\"Select the general preferences panel\"></map><!-- End --></body></html>";
