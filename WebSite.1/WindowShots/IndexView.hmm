{
    HtmlMetaData = "<html><head><title>MapSpinner Page</title><meta name=\"GENERATOR\" content=\"MapSpinner\"></head><body><p></p><!-- Created by MapSpinner --><!-- Beginning --><img src=\"CatalogView.png\" width=\"1130\" height=\"672\" usemap=\"#CatalogView\" border=\"0\"><map name=\"CatalogView\"><area shape=\"rect\" coords=\"42,135,188,156\" alt=\"Images\" title=\"Displays all the slots which have disks identified as images or pictures.\" nohref><area shape=\"rect\" coords=\"42,312,188,595\" alt=\"Search For\" title=\"Select one of these predefined search patterns to display slots matching the pattern.\" nohref><area shape=\"rect\" coords=\"42,269,188,288\" alt=\"Bookmarks\" title=\"Store favorite or frequently used disks here to quickly select a disk.\" nohref><area shape=\"rect\" coords=\"42,222,188,263\" alt=\"Carousels\" title=\"Select one of your carousels to show the contents of the library for the carousel.\" nohref><area shape=\"rect\" coords=\"42,173,188,194\" alt=\"Music\" title=\"Displays all slots containing disks marked as music.\" nohref><area shape=\"rect\" coords=\"42,154,188,175\" alt=\"Movies\" title=\"Displays all the slots which have disks identified as movies.\" nohref><area shape=\"rect\" coords=\"42,117,188,138\" alt=\" Files\" title=\"Displays all the slots which have disks identified as files.\" nohref><area shape=\"rect\" coords=\"191,581,1086,595\" alt=\"Path\" title=\"Displays the carousel, slot number, and path of the selected item.\" nohref><area shape=\"rect\" coords=\"1004,113,1076,578\" alt=\"Ratings column\" title=\"Displays the ratings of the discs in the library.  Click in this column, to set the rating of your favorite music and movies for example.\" nohref><area shape=\"rect\" coords=\"854,113,1002,578\" alt=\"Tags column\" title=\"Displays the tags assigned to the discs in the library.  quick in this column to set one or more tags for a disk.\" nohref><area shape=\"rect\" coords=\"755,113,852,578\" alt=\"Comments column\" title=\"Displays the comments assigned to the disks. Click in this column  to enter any arbitrary text you would like to assign to a disk.\" nohref><area shape=\"rect\" coords=\"627,113,753,578\" alt=\"Date added column\" title=\"Dispalys the date the disk was added to the library\" nohref><area shape=\"rect\" coords=\"597,112,625,577\" alt=\"Kind column\" title=\"Displays the kind of disk in the slot.\" nohref><area shape=\"rect\" coords=\"469,113,595,578\" alt=\"Last checkout column\" title=\"Displays the date the disk was last checked out from the library.\" nohref><area shape=\"rect\" coords=\"449,113,468,578\" alt=\"Checked out column\" title=\"Displays whether the disk assigned to the slot is currently checked out or not.\" nohref><area shape=\"rect\" coords=\"404,113,447,578\" alt=\"Slot column\" title=\"Displays the slot number assigned to the disk\" nohref><area shape=\"rect\" coords=\"228,113,402,578\" alt=\"Name column\" title=\"Displays a name assigned to the disk.  Names are automatically generated by the program but you may override the name if you desire.\" nohref><area shape=\"rect\" coords=\"212,113,228,578\" alt=\"Disk column\" title=\"Displays the kind of disk assigned to the slot, DVD, CD, Blu-ray etc.\" nohref><area shape=\"rect\" coords=\"192,113,209,578\" alt=\"Reveal  column\" title=\"Use this column to display the contents of the disk.\" nohref><area shape=\"rect\" coords=\"883,54,1080,75\" alt=\"Search\" title=\"Searches for disks in the library by their name, comments, or tags.\" nohref><area shape=\"rect\" coords=\"1004,96,1074,111\" alt=\"Ratings\" title=\" Click on this column heading to sort the slots by their rating.\" nohref><area shape=\"rect\" coords=\"855,96,1001,111\" alt=\"Tags\" title=\" Click on the column heading to sort the disk by their tags.\" nohref><area shape=\"rect\" coords=\"756,96,852,111\" alt=\"Comments\" title=\"Click on this column heading to sort the disks by their comments.\" nohref><area shape=\"rect\" coords=\"626,97,752,112\" alt=\"Date Added\" title=\"Click on this column heading to sort the list by the date they were added to the library.\" nohref><area shape=\"rect\" coords=\"595,96,622,111\" alt=\"Kind\" title=\"Click on this column heading to sort the just by the kind of disk.\" nohref><area shape=\"rect\" coords=\"469,96,592,111\" alt=\"Last Check Out\" title=\"Click on this column heading to sort the list by their last time they were checked out.\" nohref><area shape=\"rect\" coords=\"448,97,469,112\" alt=\"Checked Out\" title=\"Click on this column heading to sort the slots by the checked out flag.\" nohref><area shape=\"rect\" coords=\"404,97,447,112\" alt=\"Slot\" title=\"Click on the column heading to sort the slots by their slot number.\" nohref><area shape=\"rect\" coords=\"192,95,402,110\" alt=\"Name\" title=\"Click on this column heading to sort the slots by their name.\" nohref><area shape=\"rect\" coords=\"638,52,663,73\" alt=\"GoTo\" title=\"Click on this button to open the slot on the carousel.  Using this button will not change the time of the last check out.\" nohref><area shape=\"rect\" coords=\"583,52,608,73\" alt=\"Close Door\" title=\"Use this button to close the door of the carousel.\" nohref><area shape=\"rect\" coords=\"512,53,537,74\" alt=\"Delete\" title=\"Use this button to delete the slot from the library.\" nohref><area shape=\"rect\" coords=\"471,52,496,73\" href=\"screenshot/addslot.html\" alt=\"Add\" title=\"Use this button to add a disk to the library.\"><area shape=\"rect\" coords=\"421,52,446,73\" alt=\"Eject\" title=\"Use this button to eject a disk from your disk drive, hold option key down to eject a second drive.\" nohref><area shape=\"rect\" coords=\"382,51,407,72\" alt=\"Mount button\" title=\"Use this button to open the selected item after you have inserted a disk into your computer. \" nohref><area shape=\"rect\" coords=\"126,52,151,73\" alt=\"Check In\" title=\"Use this button to manually check a disk back into the library.  in normal use, you simply insert the disk into your drive and the program will automatically select the correct slot and open the door of the carousel.\" nohref><area shape=\"rect\" coords=\"64,52,89,73\" alt=\"Check Out\" title=\"Use this button to check out a disk from the library. The last checkout date will be updated to the current time, and that this will be flagged as checked out.\" onmouseover=\"window.status='YOUR_MESSAGE';return true;\n\n\" nohref></map><!-- End --></body></html>";
