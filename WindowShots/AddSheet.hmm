{
    HtmlMetaData = "<html><head><title>MapSpinner Page</title><meta name=\"GENERATOR\" content=\"MapSpinner\"></head><body><p></p><!-- Created by MapSpinner --><!-- Beginning --><img src=\"AddSheetMusic.png\" width=\"496\" height=\"325\" usemap=\"#AddSheetMusic\" border=\"0\"><map name=\"AddSheetMusic\"><area shape=\"rect\" coords=\"382,285,467,306\" nohref><area shape=\"rect\" coords=\"280,284,365,306\" title=\"Click this button to cancel the addition.\" nohref><area shape=\"rect\" coords=\"362,223,460,244\" title=\" this will select the kind of this media being added to the library. You may select files, images, movies, or music.\" nohref><area shape=\"rect\" coords=\"113,224,304,246\" title=\" Move the slider to the desired scan depth. The minimum setting will  resulted in only the top level files and folders being indexed for the disk. The maximum setting will index all of the files  and folders and may take some time if the disk contains thousands of items.\" nohref><area shape=\"rect\" coords=\"71,188,459,210\" title=\" Enter a title to be used as the name for the slot. This field will automatically be entered when the disk is mounted but you may override it to enter any desired name.\" nohref><area shape=\"rect\" coords=\"71,154,305,174\" title=\"Select a mounted disk to be indexed in catalog. Use the \"No Disk\" selection to  enter a title  for a slot to be added without any just being mounted.\" nohref><area shape=\"circle\" coords=\"181,93,12\" title=\"Spin the wheel to the desired slot number. You may also select the wheel and then use the up and down arrow keys to increment and decrement the slot numbers sequentially.\" nohref><area shape=\"rect\" coords=\"127,81,157,101\" title=\" Clicking on the arrow will cause the carousel to open the slot number being displayed. You may want to use this for example, if you have overwritten the slot number and want to verify that slot is empty in the carousel.\" nohref><area shape=\"rect\" coords=\"73,81,127,101\" title=\"Enter the slot number to be added. The first available empty slot will be selected automatically, however you may override this and select any slot you wish.  You may also use the up and down arrow keys to  increment and decrement the slot number sequentially.\" nohref><area shape=\"rect\" coords=\"35,43,305,65\" title=\"Selects the carousel in which the slot will be added.\" nohref></map><!-- End --></body></html>";
